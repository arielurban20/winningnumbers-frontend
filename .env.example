# ============================================
# US Lottery Results - Environment Variables
# ============================================
# Copy this file to .env.local for development
# or .env for production deployment

# ============================================
# API Configuration
# ============================================
# Server-side API base URL (used in Server Components and API routes)
API_BASE_URL=https://winningnumbers.us

# Client-side API base URL (exposed to browser, used in client components)
NEXT_PUBLIC_API_BASE_URL=https://winningnumbers.us

# ============================================
# Site Configuration
# ============================================
# Your production domain - used for SEO metadata, sitemaps, canonical URLs
# IMPORTANT: Update this to your actual domain before deploying
NEXT_PUBLIC_SITE_URL=https://winningnumbers.us

# ============================================
# Logo Configuration
# ============================================
# Base URL for lottery game logos (SVG/PNG)
# Logos should be named: {stateSlug}-{gameSlug}.svg or .png
# Multi-state games: powerball.svg, mega-millions.svg
NEXT_PUBLIC_LOGO_BASE_URL=https://winningnumbers.us/assets/logos

# ============================================
# Node Environment
# ============================================
# Set to 'production' for production deployment
NODE_ENV=production

# ============================================
# Optional: Analytics & Monitoring
# ============================================
# Add your analytics keys here if needed
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
